# Required for the default one-image workflow.
IMAGE_API_BASE_URL=https://api.openai.com/v1
IMAGE_API_KEY=replace-with-your-image-api-key
IMAGE_MODEL=gpt-image-2
IMAGE_SIZE=1024x1024
IMAGE_RESPONSE_FORMAT=b64_json
IMAGE_REQUEST_TIMEOUT_MS=360000

# Optional: only needed for unattended CLI analysis outside Codex.
# TEXT_API_BASE_URL=https://api.openai.com/v1
# TEXT_API_KEY=replace-with-your-text-api-key
# TEXT_MODEL=gpt-4.1-mini
# TEXT_REQUEST_TIMEOUT_MS=120000
